# SchoolPilot production environment — cPanel/WHM VPS.
#
# Install to /home/schoolpilot/shared/backend.env (NOT into a release
# directory; deploy.sh symlinks each release's .env at this file so it
# survives deploys), then:
#
#   chown schoolpilot:schoolpilot /home/schoolpilot/shared/backend.env
#   chmod 600 /home/schoolpilot/shared/backend.env
#
# 600 matters on a shared box. The document root is
# /home/schoolpilot/current/backend/public, so this file is not web-reachable
# — but it is still readable by any other process running as another user if
# the mode is loose.

APP_NAME=SchoolPilot
APP_ENV=production

# --- APP_KEY ---------------------------------------------------------------
#
# Carry over the key the data was encrypted with. DO NOT run key:generate on a
# box that already has school data: student medical fields are encrypted with
# this key and a new one makes those columns permanently unreadable. There is
# no recovery short of restoring a backup taken under the old key.
#
# First deploy only:  php artisan key:generate --show
# Then store it somewhere that is not this repository and not this server.
APP_KEY=

# Debug pages print environment variables, database credentials and stack
# traces containing student data. Never true here, not even for ten minutes
# while chasing a bug — use storage/logs instead.
APP_DEBUG=false

APP_URL=https://schoolpilot.org.ng

# Password-reset and account-setup links point here, and {subdomain} is
# substituted per school. A parent on a phone must be able to open it.
FRONTEND_URL=https://{subdomain}.schoolpilot.org.ng

# --- Logging ---------------------------------------------------------------
# `daily` rather than `single`: a single never-rotated log file on school-hours
# traffic fills the partition, and a full disk stops Postgres before it stops
# PHP. cron/schoolpilot.cron prunes anything older than 14 days.
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database --------------------------------------------------------------
#
# Postgres, installed on the VPS directly — cPanel does not manage it and WHM
# backups will not include it. See cron/schoolpilot.cron for the nightly dump.
#
# Postgres, not MySQL, is required rather than preferred:
# UserManagementController uses `ilike`, which MySQL does not implement.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=schoolpilot
DB_USERNAME=schoolpilot_user
DB_PASSWORD=

# --- Redis / queues / cache ------------------------------------------------
#
# Check the extension first:  /opt/cpanel/ea-php82/root/usr/bin/php -m | grep redis
# If it is absent, install it from WHM > Software > Module Installers > PECL
# for ea-php82. If you cannot get it, leave the three drivers below on
# `database` — that is the application default and it works. Slower under
# load, not broken.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Sessions stay on `database` deliberately. A Redis flush or restart would log
# every teacher out mid-lesson; the database store survives it.
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Leave SESSION_DOMAIN unset. Unset means a host-only cookie, so a session on
# one school's subdomain cannot be presented at another's. Setting it to
# `.schoolpilot.org.ng` would share one cookie across every tenant on the
# platform, which is a tenant-isolation hole, not a convenience.
# SESSION_DOMAIN=

# --- TLS -------------------------------------------------------------------
# Apache terminates TLS and proxies plain HTTP to the apps. Without this
# Laravel builds http:// links in parent-facing emails and marks cookies
# insecure.
FORCE_HTTPS=true

# --- Auth ------------------------------------------------------------------
#
# LAUNCH.md §1: leave this FALSE until every School Admin and Super Admin has
# completed enrolment at /security. Turning it on first locks all of them out
# of everything except the enrolment endpoint — including you.
AUTH_REQUIRE_ADMIN_2FA=false

# --- Mail ------------------------------------------------------------------
# `log` swallows every password-reset and account-setup link silently. A real
# transport must be set before the first school is onboarded.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@schoolpilot.org.ng
MAIL_FROM_NAME=SchoolPilot

# --- Payments (LIVE) -------------------------------------------------------
# Confirm both are in Live Mode with signed webhook validation enabled, and
# that the webhook URLs registered with Paystack and Flutterwave point at
# https://schoolpilot.org.ng/api/v1/... — a test-mode key here means real fee
# payments silently never reconcile.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# --- AI --------------------------------------------------------------------
# Spend is metered whether or not a cap is set, so it is reasonable to watch a
# week of real usage before choosing the number. Blank = uncapped.
ANTHROPIC_API_KEY=
AI_DAILY_COST_CAP_KOBO=
AI_ALERT_THRESHOLD=0.8
AI_USD_TO_NGN=1500

# --- Messaging -------------------------------------------------------------
# Blank keys record a failed send rather than a fake success, so an untested
# channel shows up in the notification history as failures. Send one real test
# message per channel after setting these (LAUNCH.md §1).
SMS_API_KEY=
SMS_SENDER_ID=SchoolPilot
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=SchoolPilot

# --- Push ------------------------------------------------------------------
# Path (relative to the backend root) or the single-line JSON itself.
FCM_CREDENTIALS=
FCM_PROJECT_ID=
FCM_ANDROID_CHANNEL_ID=schoolpilot_default

# --- Backups (read by backup-db.sh) ---------------------------------------
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
