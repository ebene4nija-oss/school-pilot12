# Public marketing site. All values are baked in at build time.

NEXT_PUBLIC_SITE_URL=https://schoolpilot.org.ng
NEXT_PUBLIC_TENANT_DOMAIN=schoolpilot.org.ng
# The Laravel API, including /api/v1
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Open owner decisions (Landing PRD §24). Leave blank until decided: the site
# hides what is not set rather than showing a placeholder.
# WhatsApp Business number, digits only, international form: 2348031234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public demo school (Phase 1b), e.g. https://demo.schoolpilot.org.ng
NEXT_PUBLIC_DEMO_SCHOOL_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Data-protection contact for /trust and /privacy
NEXT_PUBLIC_PRIVACY_EMAIL=

# Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY on the backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cookieless analytics (self-hosted Plausible or Umami)
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT=
