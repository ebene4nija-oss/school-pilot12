# Public marketing site. All values are baked in at build time.

NEXT_PUBLIC_SITE_URL=https://schoolpilot.org.ng
NEXT_PUBLIC_TENANT_DOMAIN=schoolpilot.org.ng
# The Laravel API, including /api/v1
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# WhatsApp number, contacts, reply promise, trust/legal switches and
# screenshots are set in the console (Super Admin > Website) and fetched at
# build time. The variables below are only a fallback for local development.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_RESPONSE_MINUTES=
NEXT_PUBLIC_DEMO_SCHOOL_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Production: fail the build if the console config can't be fetched.
SITE_CONFIG_REQUIRED=

# Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY on the backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cookieless analytics (self-hosted Plausible or Umami)
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT=
