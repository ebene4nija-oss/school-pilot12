<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8+ masks launcher icons to whatever shape the device's launcher
    uses. Without this, the legacy square ic_launcher.png gets shrunk inside a
    white circle and the book's outer curves are clipped. Foreground is the
    mark alone; the navy comes from the background layer.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
