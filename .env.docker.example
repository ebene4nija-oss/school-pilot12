# Copy to .env in this directory before `docker compose up`.
# docker-compose.yml reads it; it is not the backend's own .env.

# --- Required. Compose refuses to start without these. --------------------

# Generate with: docker compose run --rm backend php artisan key:generate --show
# Changing this after a school has data makes every encrypted student medical
# field unreadable. Back it up somewhere that is not this repository.
APP_KEY=

POSTGRES_PASSWORD=

# --- Usually set -----------------------------------------------------------

APP_URL=https://schoolpilot.ng
POSTGRES_DB=schoolpilot
POSTGRES_USER=schoolpilot_user

# --- Integrations ----------------------------------------------------------
# Each of these is optional to boot. None of them silently degrade: an unset
# key means the feature reports failure, never a fake success.

ANTHROPIC_API_KEY=
# Per-school daily ceiling on AI spend, in kobo. 2500000 = ₦25,000/day.
# Unset means no cap.
AI_DAILY_COST_CAP_KOBO=

PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

SMS_API_KEY=
WHATSAPP_API_KEY=

FCM_CREDENTIALS=
FCM_PROJECT_ID=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@schoolpilot.ng
