APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Where the admin portal is served from. Password-reset and account-setup links
# point here, so it must be reachable by a parent on a phone — not `localhost`
# in any real deployment. `{subdomain}` is substituted per school.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs instead of sending it. That is fine locally,
# but a deployment left on `log` silently swallows every password-reset and
# account-setup link — set a real transport before onboarding a school.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SchoolPilot Third-Party Integration Credentials
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Messaging — Termii (SMS and the WhatsApp channel).
#
# Leave these blank and messaging reports failure; it does not quietly succeed.
# They used to default to `mock_sms_key` / `mock_key`, which the services read
# as "log it and return success", so an unconfigured school saw a fee-reminder
# history full of deliveries that never happened.
SMS_API_KEY=
SMS_SENDER_ID=SchoolPilot
WHATSAPP_API_KEY=
WHATSAPP_SENDER_ID=SchoolPilot

# Push notifications — Firebase Cloud Messaging HTTP v1.
#
# Firebase console > Project settings > Service accounts > Generate new private
# key. Set FCM_CREDENTIALS to either the path of that JSON file (relative paths
# resolve from the backend root) or the JSON document itself, single-line, for
# hosts that only give you environment variables.
#
# There is no FCM_SERVER_KEY any more. That addressed the legacy /fcm/send
# endpoint, which Google shut down in June 2024.
FCM_CREDENTIALS=
# Optional; defaults to the project_id inside the credentials.
FCM_PROJECT_ID=
# Must match the Android notification channel the Flutter app creates.
FCM_ANDROID_CHANNEL_ID=schoolpilot_default

